script(type="application/ld+json").
  {
    "@context": "https://schema.org",
    "@type": "#{schemaType || 'WebPage'}",
    "name": "#{title}",
    "description": "#{description}",
    "url": "#{canonical}",
    "publisher": {
      "@type": "Organization",
      "name": "#{site.brand.name}",
      "email": "#{site.brand.email}",
      "url": "#{site.domain.url}"
    }
  }